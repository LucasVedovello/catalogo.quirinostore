# Copie para .env.local e preencha.

# Supabase (Project Settings → API). Sem essas duas variáveis o catálogo roda com dados de exemplo (mock).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número do vendedor no formato internacional, só dígitos (55 + DDD + número).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Opcional: usuário do Instagram (sem @) para o link no menu/rodapé.
NEXT_PUBLIC_INSTAGRAM=
