{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalogo-quirinostore",
  // Worker e assets gerados por `npm run build:cloudflare` (@opennextjs/cloudflare)
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Variáveis NEXT_PUBLIC_* são embutidas no build: defina-as nas variáveis de
  // ambiente de BUILD do projeto na Cloudflare (Settings → Variables and Secrets / Build).
}
